Dialogue: 0,0:00:00.00,0:00:02.44,Black,Credits,0,0,0,,Tradução: Vacalos e Mangas\NLegendas: Vacalos e Mangas / KevinVG207\N-Proibida a distribuição das legendas junto ao vídeo-
Dialogue: 0,0:00:13.60,0:00:14.85,Black,Daiwa Scarlet,0,0,0,,Ué?
Dialogue: 0,0:00:14.85,0:00:16.14,Black,Daiwa Scarlet,0,0,0,,Onde eu estou...?
Dialogue: 0,0:00:17.27,0:00:18.16,Black,Daiwa Scarlet,0,0,0,,O qu-?!
Dialogue: 0,0:00:21.62,0:00:24.24,Black,Daiwa Scarlet,0,0,0,,Todo mundo, o que foi?
Dialogue: 0,0:00:25.22,0:00:26.68,Black,Daiwa Scarlet,0,0,0,,Ei!
Dialogue: 0,0:00:28.10,0:00:29.93,Black,Daiwa Scarlet,0,0,0,,Pelo menos me responda!
Dialogue: 0,0:00:44.88,0:00:47.14,Black,Daiwa Scarlet,0,0,0,,E-eu preciso fugir!
Dialogue: 0,0:00:53.47,0:00:55.87,Black,Daiwa Scarlet,0,0,0,,Nãããooo! Alguém me ajuda!
Dialogue: 0,0:01:02.97,0:01:04.99,Black,Daiwa Scarlet,0,0,0,,Ai...
Dialogue: 0,0:01:04.99,0:01:07.58,Black,Daiwa Scarlet,0,0,0,,Estou... salva?
Dialogue: 0,0:01:13.41,0:01:14.83,Black,Daiwa Scarlet,0,0,0,,Você está brincando, né?
Dialogue: 0,0:01:15.53,0:01:18.22,Black,Daiwa Scarlet,0,0,0,,Ainda não acabou?
Dialogue: 0,0:01:19.75,0:01:20.96,Black,Daiwa Scarlet,0,0,0,,Eu...
Dialogue: 0,0:01:20.96,0:01:23.23,Black,Daiwa Scarlet,0,0,0,,...não vou...
Dialogue: 0,0:01:23.23,0:01:25.44,Black,Daiwa Scarlet,0,0,0,,...deixar você me pegar!
Dialogue: 0,0:01:36.93,0:01:40.00,Black,Daiwa Scarlet,0,0,0,,Pessoal! Esperem!
Dialogue: 0,0:01:41.11,0:01:42.54,Black,Daiwa Scarlet,0,0,0,,Te pegu-- ah!
Dialogue: 0,0:01:55.58,0:01:56.87,Black,Daiwa Scarlet,0,0,0,,Não...
Dialogue: 0,0:01:58.49,0:02:00.02,Black,Daiwa Scarlet,0,0,0,,Me ajuda!
Dialogue: 0,0:02:13.39,0:02:15.03,Black,Daiwa Scarlet,0,0,0,,Ué?
Dialogue: 0,0:02:15.41,0:02:16.74,Black,Daiwa Scarlet,0,0,0,,Vamos lá...
Dialogue: 0,0:02:17.13,0:02:19.60,Black,Daiwa Scarlet,0,0,0,,Heh, que sonho estranho.
